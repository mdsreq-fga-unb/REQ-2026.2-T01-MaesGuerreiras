# Copie para .env e preencha com os dados do projeto no Supabase
# (Project Settings > API). Nunca commite o arquivo .env.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_KEY=cole-aqui-a-publishable-key
# Só no servidor (cadastro de usuários). Não exponha no navegador.
SUPABASE_SERVICE_KEY=cole-aqui-a-secret-key
